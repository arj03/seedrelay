{
  "name": "seedrelay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "App-neutral relay for seedkernel nodes, as a signed seedkernel bundle: signed registration, rooms and splices.",
  "exports": {
    ".": "./relay.mjs",
    "./rooms": "./rooms.mjs"
  },
  "bin": {
    "seedrelay": "./server.mjs"
  },
  "files": [
    "bundle/relay.skb",
    "relay.mjs",
    "rooms.mjs",
    "server.mjs"
  ],
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/relay.test.mjs"
  },
  "dependencies": {
    "seedkernel-wasm": "file:../seedkernel/WASM"
  },
  "engines": {
    "node": ">=20"
  }
}
